APP_ENV=development
LOG_LEVEL=INFO
LOG_PROMPTS=false
DATABASE_URL=sqlite:///./data/app.db
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/audio
MAX_UPLOAD_SIZE_MB=50
MIN_DURATION_SEC=10
MAX_DURATION_SEC=1800
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
STT_PROVIDER=faster_whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SEC=90
MAX_CONCURRENT_JOBS=1
JOB_MAX_ATTEMPTS=3
AUDIO_RETENTION_DAYS=30
RATE_LIMIT_UPLOADS_PER_HOUR=20
DAILY_ANALYSIS_LIMIT=50
CORS_ORIGINS=http://localhost:5173
# Optional: Cloud reference transcription for Milestone 4 benchmarking
GEMINI_API_KEY=
